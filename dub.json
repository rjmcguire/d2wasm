{
    "name": "d-to-wasm-compiler",
    "description": "A focused D language compiler targeting WebAssembly",
    "authors": ["D-to-WASM Project"],
    "license": "MIT",
    "targetType": "executable",
    "targetName": "d2wasm",
    "sourcePaths": ["src"],
    "importPaths": ["src"],
    
    "dependencies": {
        "wasm3-d": "~>0.3.0"
    },
    
    "libs": ["tree-sitter", "ffi"],
    "lflags": ["-L/opt/homebrew/lib", "./grammar/tree-sitter-d/libtree-sitter-d.a", "./grammar/tree-sitter-c/libtree-sitter-c.a", "./grammar/tree-sitter-javascript/libtree-sitter-javascript.a", "./runtime/ffi_trampoline.o", "-framework", "CoreServices", "-lobjc"],
    "preBuildCommands": [
        "sh runtime/build_ffi.sh"
    ],
    
    "configurations": [
        {
            "name": "default",
            "targetType": "executable",
            "mainSourceFile": "src/main.d"
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "mainSourceFile": "src/main.d",
            "buildOptions": ["unittests"]
        }
    ],
    
    "buildTypes": {
        "debug": {
            "buildOptions": ["debugMode", "debugInfo"]
        },
        "release": {
            "buildOptions": ["releaseMode", "optimize", "inline"]
        }
    },
    
    "subPackages": [
        {
            "name": "tests",
            "targetType": "executable",
            "targetName": "test-runner", 
            "sourcePaths": ["tests", "src"],
            "importPaths": ["tests", "src"],
            "mainSourceFile": "tests/main.d",
            "buildOptions": ["unittests"],
            "excludedSourceFiles": ["tests/examples/*.d", "src/main.d"],
            "libs": ["tree-sitter", "ffi"],
            "lflags": ["-L/opt/homebrew/lib", "./grammar/tree-sitter-d/libtree-sitter-d.a", "./grammar/tree-sitter-c/libtree-sitter-c.a", "./grammar/tree-sitter-javascript/libtree-sitter-javascript.a", "./runtime/ffi_trampoline.o", "-framework", "CoreServices", "-lobjc"]
        }
    ]
}