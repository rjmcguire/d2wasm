{
    "name": "d-to-wasm-compiler",
    "description": "A focused D language compiler targeting WebAssembly",
    "authors": ["D-to-WASM Project"],
    "license": "MIT",
    "targetType": "executable",
    "targetName": "d2wasm",
    "sourcePaths": ["src"],
    "importPaths": ["src"],
    
    "configurations": [
        {
            "name": "default",
            "targetType": "executable",
            "mainSourceFile": "src/main.d"
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "mainSourceFile": "src/main.d",
            "buildOptions": ["unittests"]
        }
    ],
    
    "buildTypes": {
        "debug": {
            "buildOptions": ["debugMode", "debugInfo"]
        },
        "release": {
            "buildOptions": ["releaseMode", "optimize", "inline"]
        }
    },
    
    "subPackages": [
        {
            "name": "tests",
            "targetType": "executable",
            "targetName": "test-runner", 
            "sourcePaths": ["tests", "src"],
            "importPaths": ["tests", "src"],
            "mainSourceFile": "tests/main.d",
            "buildOptions": ["unittests"],
            "excludedSourceFiles": ["tests/examples/*.d", "src/main.d"]
        }
    ]
}