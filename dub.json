{
    "name": "d-to-wasm-compiler",
    "description": "A focused D language compiler targeting WebAssembly",
    "authors": ["D-to-WASM Project"],
    "license": "MIT",
    "targetType": "executable",
    "targetName": "d2wasm",
    "sourcePaths": ["src"],
    "importPaths": ["src"],
    "excludedSourceFiles": ["src/codegen/native/arm64/stencils/source.d"],
    
    "dependencies": {
        "wasm3-d": { "path": "thirdparty/wasm3-d" }
    },

    "libs-posix": ["ffi"],
    "libs-osx": ["objc"],
    "libs-linux": ["dl"],
    "sourceFiles-posix": [
        "grammar/tree-sitter-d/libtree-sitter-d.a",
        "grammar/tree-sitter-c/libtree-sitter-c.a",
        "grammar/tree-sitter-javascript/libtree-sitter-javascript.a",
        "runtime/ffi_trampoline.o",
        "thirdparty/tree-sitter/libtree-sitter.a"
    ],
    "sourceFiles-windows": [
        "grammar/tree-sitter-d/libtree-sitter-d.lib",
        "grammar/tree-sitter-c/libtree-sitter-c.lib",
        "grammar/tree-sitter-javascript/libtree-sitter-javascript.lib",
        "runtime/ffi_trampoline.obj",
        "thirdparty/tree-sitter/libtree-sitter.lib"
    ],
    "lflags-osx": ["-L/opt/homebrew/lib", "-framework", "CoreServices"],
    "preBuildCommands": [
        "sh grammar/build.sh",
        "sh runtime/build_ffi.sh"
    ],
    
    "configurations": [
        {
            "name": "default",
            "targetType": "executable",
            "mainSourceFile": "src/main.d"
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "mainSourceFile": "src/main.d",
            "buildOptions": ["unittests"]
        }
    ],
    
    "buildTypes": {
        "debug": {
            "buildOptions": ["debugMode", "debugInfo"]
        },
        "release": {
            "buildOptions": ["releaseMode", "optimize", "inline"]
        }
    },
    
    "subPackages": [
        {
            "name": "tests",
            "targetType": "executable",
            "targetName": "test-runner", 
            "sourcePaths": ["tests", "src"],
            "importPaths": ["tests", "src"],
            "mainSourceFile": "tests/main.d",
            "buildOptions": ["unittests"],
            "excludedSourceFiles": ["tests/examples/*.d", "src/main.d", "src/codegen/native/arm64/stencils/source.d"],
            "libs-posix": ["ffi"],
            "libs-osx": ["objc"],
            "libs-linux": ["dl"],
            "sourceFiles-posix": [
                "grammar/tree-sitter-d/libtree-sitter-d.a",
                "grammar/tree-sitter-c/libtree-sitter-c.a",
                "grammar/tree-sitter-javascript/libtree-sitter-javascript.a",
                "runtime/ffi_trampoline.o",
                "thirdparty/tree-sitter/libtree-sitter.a"
            ],
            "sourceFiles-windows": [
                "grammar/tree-sitter-d/libtree-sitter-d.lib",
                "grammar/tree-sitter-c/libtree-sitter-c.lib",
                "grammar/tree-sitter-javascript/libtree-sitter-javascript.lib",
                "runtime/ffi_trampoline.obj",
                "thirdparty/tree-sitter/libtree-sitter.lib"
            ],
            "lflags-osx": ["-L/opt/homebrew/lib", "-framework", "CoreServices"]
        }
    ]
}